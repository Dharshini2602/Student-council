# PPGIT Student Council Environment Configuration
# Copy this file to .env for local development

# Application Information
VITE_APP_TITLE="PPGIT Student Council"
VITE_COLLEGE_NAME="PPG Institute of Technology"
VITE_COLLEGE_EMAIL_DOMAIN="ppg.edu.in"

# Feedback & Student Voice API Endpoint (Optional Backend Service)
# When left empty, submissions run with local demonstration client validation and development persistence
VITE_FEEDBACK_API_URL=""

# Official College Portal & Social Links
VITE_COLLEGE_WEBSITE_URL="https://www.ppgit.ac.in"
VITE_COUNCIL_EMAIL="studentcouncil@ppg.edu.in"
